pair_coeff 1 5 lj/cut 0.05477 ${sig_CuC} ${rc_CuC}
pair_coeff 1 5 lj/cut 0.05477 2.168 ${rc_CuC}
pair_coeff 1 5 lj/cut 0.05477 2.168 5.4
pair_coeff 3 5 lj/cut ${eps_CuC} ${sig_CuC} ${rc_CuC}
pair_coeff 3 5 lj/cut 0.05477 ${sig_CuC} ${rc_CuC}
pair_coeff 3 5 lj/cut 0.05477 2.168 ${rc_CuC}
pair_coeff 3 5 lj/cut 0.05477 2.168 5.4
pair_coeff 2 5 lj/cut ${eps_TaC} ${sig_TaC} ${rc_TaC}
