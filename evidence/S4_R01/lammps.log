dump traj all custom 3272 ${run_dir}/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump traj all custom 3272 /Volumes/CuTaData/CuTa-results/runs/S4_R01/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump_modify traj sort id

restart 25000 ${run_dir}/metadata/restart.a ${run_dir}/metadata/restart.b
restart 25000 /Volumes/CuTaData/CuTa-results/runs/S4_R01/metadata/restart.a ${run_dir}/metadata/restart.b
restart 25000 /Volumes/CuTaData/CuTa-results/runs/S4_R01/metadata/restart.a /Volumes/CuTaData/CuTa-results/runs/S4_R01/metadata/restart.b

variable ramp_steps    equal round(v_ramp/v_dt_ps)
variable scratch_steps equal round((v_length+v_gap)/(v_vs*v_dt_ps))

print "oscillation: alpha=${alpha} beta=${beta} A=$(v_A) A  f=$(v_f) 1/ps  T=$(v_T) ps  ramp=$(v_ramp) ps"
oscillation: alpha=0.25 beta=1.0 A=2.5 A  f=0.019098593171027401089 1/ps  T=52.359877559829996585 ps  ramp=157.07963267949000397 ps
print "stages: ramp ${ramp_steps} steps with x held, then cut ${length} A + gap ${gap} A = ${scratch_steps} steps"
stages: ramp 157080 steps with x held, then cut 276.0 A + gap 10.0 A = 953333 steps

# Convention guard against the campaign generator. Flattened into one boolean
# per quantity: a nested if inside an if argument does not survive LAMMPS quote
# parsing ("Input line quote not followed by white-space"). The leading factor
# is the "was it supplied" test, so an unsupplied -1.0 default scores 0, and the
# denominator carries an epsilon so a supplied 0 cannot divide by zero.
variable A_bad equal (v_A_case>0)*((abs(v_A-v_A_case)/(abs(v_A_case)+1.0e-30))>0.001)
variable f_bad equal (v_f_case>0)*((abs(v_f-v_f_case)/(abs(v_f_case)+1.0e-30))>0.001)
if "$(v_A_bad) == 1" then   "print 'ERROR: A = alpha*h0 = $(v_A) A disagrees with the campaign A_case = ${A_case} A.'"   "print 'The template and generate_campaign.py are using different conventions.'"   "quit 1"
if "$(v_f_bad) == 1" then   "print 'ERROR: f = beta*vs/(2*pi*A) = $(v_f) 1/ps disagrees with the campaign f_case = ${f_case} 1/ps.'"   "print 'The template and generate_campaign.py are using different conventions.'"   "quit 1"

run ${ramp_steps}
