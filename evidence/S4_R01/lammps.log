# Normal high-frequency oscillatory nanoscratch. This is the alpha > 0 arm and
# the only novel axis of this study; everything else is shared with
# in.scratch_baseline.lmp, which reproduces Doan et al., J Non-Cryst Solids 605
# (2023) 122152.
#
# This file is a deliberate merge onto that validated baseline. The geometry,
# zoning, relaxation, thermostat placement and reaction-force accounting are
# identical, so a difference between the two arms is the oscillation and nothing
# else. The only structural change is the tool motion:
#   baseline     fix move linear  -vs 0 0
#   oscillatory  fix move variable v_dx v_dy v_dz v_vx v_vy v_vz
#
# WHY EVERY COMPONENT IS PRESCRIBED, INCLUDING y. Measured 2026-08-05 on a
# two-atom test: a NULL component of fix move variable is NOT frozen -- it is
# time-integrated from the forces as usual (y went 5 -> 5.85 with v_y growing
# 0.7 -> 1.01 under NULL). A rigid diamond tool with y left NULL would shear
# apart under the workpiece reaction over a 300+ ps traverse. dy and vy are
# therefore pinned to zero explicitly, never left NULL.
#
# Settable variables use "index" style so a command-line -var wins; "equal"
# style here would collide with the index variable -var creates and abort with
# "Cannot redefine variable as a different style".

units metal
atom_style atomic
dimension 3
echo both

boundary p p p

variable run_dir   index "RUN_DIR_REQUIRED"
variable structure index "STRUCTURE_REQUIRED"
variable potential index "POTENTIAL_REQUIRED"
variable case_id   index "CASE_ID_REQUIRED"

# --- case parameters ---------------------------------------------------------
variable h0         index 10.0     # MEAN scratch depth below the free surface, A
                                   # 1.0 nm, matching campaign 04. The baseline
                                   # reproduction uses 2.0 nm because that is what
                                   # doan2023_jncs scratched.
variable vs         index 0.3      # mean scratch speed, A/ps  (0.3 = 30 m/s)
variable length     index 320.0    # scratch length at full amplitude, A
variable radius     index 30.0     # tool radius, A
variable gap        index 10.0     # tool-to-side-surface clearance, A
variable temp_K     index 300.0
variable dt_ps      index 0.001
variable seed       index 482748
variable eq_steps   index 20000    # 20 ps at 300 K, per doan2023_jncs 2.2

# --- oscillation -------------------------------------------------------------
# alpha = A/h0 is the amplitude as a fraction of the mean depth.
# beta  = 2*pi*f*A/vs is the ratio of peak oscillation speed to scratch speed;
#         beta < 1 keeps the tool advancing through the whole cycle, beta > 1
#         lets the contact break.
variable alpha      index 0.25
variable beta       index 1.0

variable A equal v_alpha*v_h0
variable f equal v_beta*v_vs/(2.0*PI*v_A)
variable T equal 1.0/v_f
variable ramp equal 3.0*v_T

# The campaign generator computes A, f, T and ramp independently in Python.
# Both must agree or one of them is using a different convention -- which would
# mislabel every case in the campaign, since the manifest's A and f are what the
# analysis reports. A negative default means "not supplied, skip the check".
variable A_case    index -1.0
variable f_case    index -1.0
variable T_case    index -1.0
variable ramp_case index -1.0

# --- sampling ----------------------------------------------------------------
# Strides come from the campaign, which sizes them from the period: >= 100 force
# samples and >= 8 atomic snapshots per cycle (protocol/output_policy.json).
variable thermo_every index 50
variable dump_every   index 1000

# --- zoning ------------------------------------------------------------------
variable fixed_t    index 4.0      # fixed layer thickness, A
variable thermo_t   index 4.0      # thermostat layer thickness, A

# --- potential arm -----------------------------------------------------------
#   arm=paper   ADP + Ta-C 0.13/2.86575 -- the production parameterisation
#   arm=deck    eam/alloy + 0.041/1.86575 -- what doan2023_jncs's deck runs
# The baseline reproduction runs arm=deck because that is the only combination
# with a published friction coefficient attached. Production runs arm=paper.
# The gap between them is quantified by the LJ sensitivity case; see
# protocol/validation_targets.json -> lj_sensitivity_case_required.
variable arm        index paper

variable eps_TaC    index 0.13
variable sig_TaC    index 2.86575
variable rc_TaC     index 7.164
variable eps_CuC    index 0.05477
variable sig_CuC    index 2.168
variable rc_CuC     index 5.4

variable overlap_scope index tool

variable tool_manifest_resolved index 0
if "${tool_manifest_resolved} == 0" then   "print 'ERROR: in.scratch_oscillatory.lmp has not been confirmed against a structure.'"   "print 'Confirm before setting the flag:'"   "print '  1. type map is 1,3=Cu 2,4=Ta 5=C and types 1-4 all carry atoms'"   "print '  2. bound(all,zmax) is the free surface, not a stray adatom'"   "print '  3. the box is longer than the traverse, so the tool never laps it'"   "print '  4. arm= matches the potential file passed in -var potential'"   "print 'Set -var tool_manifest_resolved 1 only then.'"   "quit 1"

# -----------------------------------------------------------------------------
# How many atom types the structure file is missing. Two families of structure
# reach this template and they differ here:
#   deck reproduction -- ../CuTa-MD/simulation/CuTa.CuTa.12lop.lmp declares all
#     five types itself, so 0.
#   assembled laminate -- tools/assemble_structures.py writes four (1,3 = Cu of
#     layers A,B; 2,4 = Ta of layers A,B) and cannot write the tool's fifth,
#     because the relaxation that produced it runs plain, non-hybrid adp, where
#     a fifth type mapped to NULL leaves every i-5 pair unset and LAMMPS aborts
#     with "All pair coeffs are not set". So 1, and read_data creates type 5
#     for `mass 5` and `create_atoms 5` below to fill.
# Hardcoding either value silently breaks the other family.
variable extra_types index 0
read_data ${structure} extra/atom/types ${extra_types}
read_data /Users/hust-hwashin621m/Downloads/research_new_material/CuTa-Oscillatory-Nanoscratching-MD/results/runs/relax_laminate_R01/metadata/relaxed_structure.data extra/atom/types ${extra_types}
