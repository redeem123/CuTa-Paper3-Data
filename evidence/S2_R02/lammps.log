  564184 atoms
  read_restart CPU = 0.030 seconds

variable checkpoint_mismatch equal (step!=v_checkpoint_step)
if "$(v_checkpoint_mismatch) == 1" then   "print 'ERROR: restart is at $(step), but checkpoint_step is ${checkpoint_step}.'"   "quit 1"

# Hybrid ADP/LJ does not retain all pair information through a binary restart.
# Re-declaring the same paper-arm force field is therefore required before the
# first force evaluation; it is not a new parameterisation.
pair_style hybrid adp lj/cut 7.5
pair_coeff * * adp ${potential} Cu Ta Cu Ta NULL
pair_coeff * * adp /Users/hust-hwashin621m/Downloads/research_new_material/CuTa-Oscillatory-Nanoscratching-MD/potentials/CuTa_LJ15_2014.adp.txt Cu Ta Cu Ta NULL
pair_coeff 1 5 lj/cut 0.05477 2.168 5.4
pair_coeff 3 5 lj/cut 0.05477 2.168 5.4
pair_coeff 2 5 lj/cut 0.13 2.86575 7.164
pair_coeff 4 5 lj/cut 0.13 2.86575 7.164
pair_coeff 5 5 none
neighbor 2 bin
neigh_modify every 1 delay 0 check yes
timestep ${dt_ps}
timestep 0.001

# Groups are stored in the restart file. Refusing an absent one is clearer than
# continuing with an empty fixed, thermostat, or tool group after a corrupted
# checkpoint.
if "$(count(tool)) == 0" then   "print 'ERROR: restart has no tool group.'"   "quit 1"
if "$(count(newtonian)) == 0" then   "print 'ERROR: restart has no newtonian workpiece group.'"   "quit 1"
if "$(count(heatsink)) == 0" then   "print 'ERROR: restart has no heatsink group.'"   "quit 1"

compute t_work newtonian temp
fix hold_fixed fixed setforce 0.0 0.0 0.0
fix integrate mobile nve
fix sink_bottom g_th_bottom temp/rescale 10 300.0 300.0 0.1 1.0
Resetting global fix info from restart file:
  fix style: temp/rescale, fix ID: sink_bottom
fix sink_left   g_th_left   temp/rescale 10 300.0 300.0 0.1 1.0
Resetting global fix info from restart file:
  fix style: temp/rescale, fix ID: sink_left

# `tstart` remains the time at which the original tool-motion fix was defined,
# not the restart time. LAMMPS restores fix move's original atom coordinates and
# initial timestep under this same `tool_motion` id, so the analytic displacement
# below continues without an x or z jump.
variable tstart equal v_scratch_start_time
variable tau    equal time-v_tstart
variable A      equal v_alpha*v_h0
variable f      equal v_beta*v_vs/(2.0*PI*v_A)
variable T      equal 1.0/v_f
variable ramp   equal 3.0*v_T
variable s      equal (v_tau<v_ramp)*0.5*(1.0-cos(PI*v_tau/v_ramp))+(v_tau>=v_ramp)*1.0
variable sdot   equal (v_tau<v_ramp)*0.5*(PI/v_ramp)*sin(PI*v_tau/v_ramp)
variable tcut   equal v_tau-v_ramp
variable dx     equal (v_tau>=v_ramp)*(-v_vs*v_tcut)
variable vx     equal (v_tau>=v_ramp)*(-v_vs)
variable dy     equal 0.0
variable vy     equal 0.0
variable dz     equal v_A*v_s*sin(2.0*PI*v_f*v_tau)
variable vz     equal v_A*(v_sdot*sin(2.0*PI*v_f*v_tau)+v_s*2.0*PI*v_f*cos(2.0*PI*v_f*v_tau))

variable A_bad equal (v_A_case>0)*((abs(v_A-v_A_case)/(abs(v_A_case)+1.0e-30))>0.001)
variable f_bad equal (v_f_case>0)*((abs(v_f-v_f_case)/(abs(v_f_case)+1.0e-30))>0.001)
if "$(v_A_bad) == 1" then   "print 'ERROR: recovered A = alpha*h0 = $(v_A) A disagrees with A_case = ${A_case} A.'"   "quit 1"
if "$(v_f_bad) == 1" then   "print 'ERROR: recovered f = beta*vs/(2*pi*A) = $(v_f) 1/ps disagrees with f_case = ${f_case} 1/ps.'"   "quit 1"

fix tool_react tool setforce 0.0 0.0 0.0
fix tool_motion tool move variable v_dx v_dy v_dz v_vx v_vy v_vz
Resetting global fix info from restart file:
  fix style: move, fix ID: tool_motion
Resetting peratom fix info from restart file:
  fix style: move, fix ID: tool_motion

variable fx equal f_tool_react[1]
variable fy equal f_tool_react[2]
variable fz equal f_tool_react[3]
variable tool_x equal v_tool_x0+v_dx
variable tool_z equal v_tool_z0+v_dz
variable phase equal (v_tau*v_f)-floor(v_tau*v_f)

compute pe_atom all pe/atom
compute stress_atom all stress/atom NULL
compute cna all cna/atom 3.5

thermo ${thermo_every}
thermo 104
thermo_style custom step time temp c_t_work pe ke etotal press   v_tool_x v_tool_z v_phase v_fx v_fy v_fz
thermo_modify flush yes

dump traj all custom ${dump_every} ${run_dir}/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump traj all custom 1308 ${run_dir}/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump traj all custom 1308 /Volumes/CuTaData/CuTa-results/runs/S2_R02/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump_modify traj sort id

# Preserve the original two checkpoints as the provenance source. Any recovery
# checkpoints are separate and cannot overwrite the interrupted-run evidence.
restart 25000 ${run_dir}/metadata/restart.resume.a ${run_dir}/metadata/restart.resume.b
restart 25000 /Volumes/CuTaData/CuTa-results/runs/S2_R02/metadata/restart.resume.a ${run_dir}/metadata/restart.resume.b
restart 25000 /Volumes/CuTaData/CuTa-results/runs/S2_R02/metadata/restart.resume.a /Volumes/CuTaData/CuTa-results/runs/S2_R02/metadata/restart.resume.b

variable remaining_steps equal v_final_step-step
variable no_remaining equal (v_remaining_steps<=0)
if "$(v_no_remaining) == 1" then   "print 'ERROR: final_step ${final_step} is not after restart step $(step).'"   "quit 1"

print "recovery: case=${case_id} checkpoint=$(step) target=${final_step} remaining=${remaining_steps} tstart=${tstart}"
recovery: case=S2_R02 checkpoint=500000 target=602083 remaining=102083 tstart=4
if "${dry_run} == 1" then   "run 0 post no"   "print 'OSCILLATORY_RESTART_SMOKE_COMPLETE case=${case_id} checkpoint=$(step)'" else   "run ${remaining_steps}"   "write_data ${run_dir}/metadata/final.data nocoeff"   "print 'OSCILLATORY_SCRATCH_COMPLETE case=${case_id} recovered_from=${checkpoint_step} alpha=${alpha} beta=${beta} h0=${h0} vs=${vs} length=${length}'"
run ${remaining_steps}
