# --- oscillation + scratching ------------------------------------------------
fix integrate mobile nve
fix sink_bottom g_th_bottom temp/rescale 10 ${temp_K} ${temp_K} 0.1 1.0
fix sink_bottom g_th_bottom temp/rescale 10 300.0 ${temp_K} 0.1 1.0
fix sink_bottom g_th_bottom temp/rescale 10 300.0 300.0 0.1 1.0
