# fix move variable takes DISPLACEMENT from the position each atom held when the
# fix was defined, so tau must be zero at that instant. "time" accumulates
# across runs, hence the captured offset rather than time itself.
variable tstart equal $(time)
variable tstart equal 4
variable tau    equal time-v_tstart

# Raised-cosine envelope and its exact derivative. fix move uses the velocity
# variables to set atom velocities directly, so an envelope whose derivative
# does not match its own displacement corrupts the tool kinetic energy and,
# through it, every streaming-velocity correction downstream.
#
# LAMMPS equal-style formulas have no C ternary; a comparison evaluates to
# 1.0 or 0.0, so the branch is written as a sum of masked terms. The inactive
# term is still evaluated and must stay finite -- cos/sin of a large argument
# are, so multiplying by a zero mask is safe here.
variable s    equal (v_tau<v_ramp)*0.5*(1.0-cos(PI*v_tau/v_ramp))+(v_tau>=v_ramp)*1.0
variable sdot equal (v_tau<v_ramp)*0.5*(PI/v_ramp)*sin(PI*v_tau/v_ramp)

# The traverse does not begin until the envelope has reached full amplitude.
# Ramping while already cutting would leave the first three cycles of track cut
# at a growing amplitude, and that damage persists into the window the analysis
# calls steady. Holding x still during the ramp costs 3T of wall time and buys a
# cut whose every cycle is at the nominal amplitude.
variable tcut equal v_tau-v_ramp
variable dx equal (v_tau>=v_ramp)*(-v_vs*v_tcut)
variable vx equal (v_tau>=v_ramp)*(-v_vs)
variable dy equal 0.0
variable vy equal 0.0
variable dz equal v_A*v_s*sin(2.0*PI*v_f*v_tau)
variable vz equal v_A*(v_sdot*sin(2.0*PI*v_f*v_tau)+v_s*2.0*PI*v_f*cos(2.0*PI*v_f*v_tau))

fix tool_react tool setforce 0.0 0.0 0.0
fix tool_motion tool move variable v_dx v_dy v_dz v_vx v_vy v_vz

variable fx equal f_tool_react[1]
variable fy equal f_tool_react[2]
variable fz equal f_tool_react[3]
variable tool_x equal v_tool_x0+v_dx
variable tool_z equal v_tool_z0+v_dz
# Cycle phase in [0,1), so the analysis never has to re-derive it from time.
variable phase equal (v_tau*v_f)-floor(v_tau*v_f)

compute pe_atom all pe/atom
compute stress_atom all stress/atom NULL
compute cna all cna/atom 3.5

thermo ${thermo_every}
thermo 418
thermo_style custom step time temp c_t_work pe ke etotal press   v_tool_x v_tool_z v_phase v_fx v_fy v_fz
WARNING: New thermo_style command, previous thermo_modify settings will be lost (src/output.cpp:912)
thermo_modify flush yes

dump traj all custom ${dump_every} ${run_dir}/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump traj all custom 2617 ${run_dir}/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump traj all custom 2617 /Volumes/CuTaData/CuTa-results/runs/S1_R02/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump_modify traj sort id

restart 25000 ${run_dir}/metadata/restart.a ${run_dir}/metadata/restart.b
restart 25000 /Volumes/CuTaData/CuTa-results/runs/S1_R02/metadata/restart.a ${run_dir}/metadata/restart.b
restart 25000 /Volumes/CuTaData/CuTa-results/runs/S1_R02/metadata/restart.a /Volumes/CuTaData/CuTa-results/runs/S1_R02/metadata/restart.b

variable ramp_steps    equal round(v_ramp/v_dt_ps)
variable scratch_steps equal round((v_length+v_gap)/(v_vs*v_dt_ps))

print "oscillation: alpha=${alpha} beta=${beta} A=$(v_A) A  f=$(v_f) 1/ps  T=$(v_T) ps  ramp=$(v_ramp) ps"
oscillation: alpha=0.1 beta=0.5 A=1 A  f=0.023873241463784299066 1/ps  T=41.887902047863903476 ps  ramp=125.66370614359199465 ps
print "stages: ramp ${ramp_steps} steps with x held, then cut ${length} A + gap ${gap} A = ${scratch_steps} steps"
stages: ramp 125664 steps with x held, then cut 229.0 A + gap 10.0 A = 796667 steps

# Convention guard against the campaign generator. Flattened into one boolean
# per quantity: a nested if inside an if argument does not survive LAMMPS quote
# parsing ("Input line quote not followed by white-space"). The leading factor
# is the "was it supplied" test, so an unsupplied -1.0 default scores 0, and the
# denominator carries an epsilon so a supplied 0 cannot divide by zero.
variable A_bad equal (v_A_case>0)*((abs(v_A-v_A_case)/(abs(v_A_case)+1.0e-30))>0.001)
variable f_bad equal (v_f_case>0)*((abs(v_f-v_f_case)/(abs(v_f_case)+1.0e-30))>0.001)
if "$(v_A_bad) == 1" then   "print 'ERROR: A = alpha*h0 = $(v_A) A disagrees with the campaign A_case = ${A_case} A.'"   "print 'The template and generate_campaign.py are using different conventions.'"   "quit 1"
if "$(v_f_bad) == 1" then   "print 'ERROR: f = beta*vs/(2*pi*A) = $(v_f) 1/ps disagrees with the campaign f_case = ${f_case} 1/ps.'"   "print 'The template and generate_campaign.py are using different conventions.'"   "quit 1"

run ${ramp_steps}
