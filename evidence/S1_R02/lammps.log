pair_coeff 4 5 lj/cut ${eps_TaC} ${sig_TaC} ${rc_TaC}
pair_coeff 4 5 lj/cut 0.13 ${sig_TaC} ${rc_TaC}
pair_coeff 4 5 lj/cut 0.13 2.86575 ${rc_TaC}
pair_coeff 4 5 lj/cut 0.13 2.86575 7.164
pair_coeff 5 5 none

neighbor 2 bin
neigh_modify every 1 delay 0 check yes
timestep ${dt_ps}
timestep 0.001

# Run-out room. The z clearance carries the oscillation amplitude on top of the
