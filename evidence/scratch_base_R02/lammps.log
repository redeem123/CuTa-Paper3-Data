# Non-oscillatory amorphous nanoscratch. This alpha = 0 template serves two
# deliberately distinct arms: Campaign 00 reproduces Doan et al., J Non-Cryst
# Solids 605 (2023) 122152, while Campaign 03 is the paper-model comparator for
# the oscillatory screening campaign. The case record selects the regime; the
# deck values below remain defaults solely for the reproduction arm.
#
# Geometry, zoning and kinematics follow the inherited deck
# CuTa-MD/simulation/Scratch.CuTa.CuTa.12lop.depth2.in, which was identified as
# that paper's own input (nine parameters match; see protocol/potential_metadata
# .json -> inherited_deck). Four defects of that deck are deliberately not
# reproduced; each is marked DECK-FIX below.
#
# The tool enters from the +x side at a fixed depth and traverses in -x. There
# is no indentation stage: the paper's tool is placed at depth with a 1.0 nm
# side gap, so the loading curve starts at first side contact.
#
# Settable variables use "index" style so a command-line -var wins; "equal"
# style here would collide with the index variable -var creates and abort with
# "Cannot redefine variable as a different style".

units metal
atom_style atomic
dimension 3
echo both

# Periodic in every direction while the structure is read, then relaxed to the
# scratch boundary once the box has been extended. Setting the final condition
# here instead would shrink-wrap onto the as-read slab and lose the run-out.
boundary p p p

variable run_dir   index "RUN_DIR_REQUIRED"
variable structure index "STRUCTURE_REQUIRED"
variable potential index "POTENTIAL_REQUIRED"
variable case_id   index "CASE_ID_REQUIRED"

# --- case parameters ---------------------------------------------------------
variable depth      index 20.0     # scratch depth below the free surface, A
variable vs         index 0.3      # scratch speed, A/ps  (0.3 = 30 m/s)
variable length     index 130.0    # scratch length, A
variable radius     index 30.0     # tool radius, A
variable gap        index 10.0     # tool-to-side-surface clearance, A
variable temp_K     index 300.0
variable dt_ps      index 0.001
variable seed       index 482748
variable eq_steps   index 20000    # 20 ps at 300 K, per doan2023_jncs 2.2
variable dump_every index 1000     # trajectory frame interval, steps

# Campaign 03 reads the Velocities section written by the relaxed laminate
# instead of discarding it in a second minimisation. The default keeps Campaign
# 00's independent deck-reproduction initialization unchanged.
variable preequilibrated index 0
variable eq_steps_pre    index 4000

# --- zoning ------------------------------------------------------------------
# Fixed atoms at the bottom AND the left, thermostat immediately inside them,
# Newtonian everywhere else. The left-hand pair is not decoration: the tool
# traverses toward -x and would otherwise push the whole slab along with it.
variable fixed_t    index 4.0      # fixed layer thickness, A
variable thermo_t   index 4.0      # thermostat layer thickness, A

# --- potential arm -----------------------------------------------------------
# The metal-metal model and the Ta-C LJ row are both unresolved between the
# papers and the deck they ship with, so neither is hard-coded. See
# potential_metadata.json -> tool_workpiece_lj.published_values_disagree.
#   arm=deck    reproduces doan2023_jncs (eam/alloy + 0.041/1.86575)
#   arm=paper   the physically defensible parameterisation (adp + 0.13/2.86575)
variable arm        index deck

variable eps_TaC    index 0.041
variable sig_TaC    index 1.86575
variable rc_TaC     index 4.6
variable eps_CuC    index 0.05477
variable sig_CuC    index 2.168
variable rc_CuC     index 5.4

# DECK-FIX 1 arm switch. The deck runs "delete_atoms overlap 1.0 all all",
# whose all-all pairing also deletes workpiece atoms sitting closer than 1.0 A
# across the Cu/Ta layer interfaces -- 1534 of them in the recorded run, i.e.
# structure discarded silently before the run starts.
#   overlap_scope=tool   pair only tool against workpiece (default, defensible)
#   overlap_scope=all    reproduce the deck exactly, interface losses included
# The reproduction arm sets "all" on purpose: its whole job is to differ from
# the published protocol in as few places as possible.
variable overlap_scope index tool

# Refuse to run until a case builder has confirmed the structure's type map and
# free-surface height against this template's assumptions. Checked here, before
# read_data, so a wrong flag costs a second instead of a minimisation plus 20 ps
# of equilibration.
variable tool_manifest_resolved index 0
if "${tool_manifest_resolved} == 0" then   "print 'ERROR: in.scratch_baseline.lmp has not been confirmed against a structure.'"   "print 'Confirm before setting the flag:'"   "print '  1. type map is 1,3=Cu 2,4=Ta 5=C and types 1-4 all carry atoms'"   "print '  2. bound(all,zmax) is the free surface, not a stray adatom'"   "print '  3. the fixed and heatsink groups are non-empty and do not overlap the contact zone'"   "print '  4. arm= matches the potential file passed in -var potential'"   "print 'Set -var tool_manifest_resolved 1 only then.'"   "quit 1"

# -----------------------------------------------------------------------------
# How many atom types the structure file is missing. Two families of structure
# reach this template and they differ here:
#   deck reproduction -- ../CuTa-MD/simulation/CuTa.CuTa.12lop.lmp declares all
#     five types itself, so 0.
#   assembled laminate -- tools/assemble_structures.py writes four (1,3 = Cu of
#     layers A,B; 2,4 = Ta of layers A,B) and cannot write the tool's fifth,
#     because the relaxation that produced it runs plain, non-hybrid adp, where
#     a fifth type mapped to NULL leaves every i-5 pair unset and LAMMPS aborts
#     with "All pair coeffs are not set". So 1, and read_data creates type 5
#     for `mass 5` and `create_atoms 5` below to fill.
# Hardcoding either value silently breaks the other family.
variable extra_types index 0
read_data ${structure} extra/atom/types ${extra_types}
read_data /Users/hust-hwashin621m/Downloads/research_new_material/CuTa-Oscillatory-Nanoscratching-MD/results/runs/relax_laminate_R02/metadata/relaxed_structure.data extra/atom/types ${extra_types}
read_data /Users/hust-hwashin621m/Downloads/research_new_material/CuTa-Oscillatory-Nanoscratching-MD/results/runs/relax_laminate_R02/metadata/relaxed_structure.data extra/atom/types 1
