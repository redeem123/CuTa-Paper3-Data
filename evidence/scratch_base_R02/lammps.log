# LAMMPS implements `shell mkdir` itself and creates every argument as a
# directory, so a `-p` flag is taken literally and leaves a directory named
# "-p" in the working directory. The launcher creates run_dir before LAMMPS
# starts, so each child below has its parent already and needs no -p.
shell mkdir ${run_dir}/logs ${run_dir}/trajectories ${run_dir}/metadata
shell mkdir /Volumes/CuTaData/CuTa-results/runs/scratch_base_R02/logs ${run_dir}/trajectories ${run_dir}/metadata
shell mkdir /Volumes/CuTaData/CuTa-results/runs/scratch_base_R02/logs /Volumes/CuTaData/CuTa-results/runs/scratch_base_R02/trajectories ${run_dir}/metadata
shell mkdir /Volumes/CuTaData/CuTa-results/runs/scratch_base_R02/logs /Volumes/CuTaData/CuTa-results/runs/scratch_base_R02/trajectories /Volumes/CuTaData/CuTa-results/runs/scratch_base_R02/metadata

# Type map: 1,3 = Cu (A-layer, B-layer), 2,4 = Ta (A-layer, B-layer), 5 = C.
# Species are split by layer so interface-band and species-resolved analysis can
# tell which alloy an atom came from; the pair styles map both Cu types to Cu.
mass 1 63.546
mass 2 180.95
mass 3 63.546
mass 4 180.95
mass 5 12.01

# Free surface and side face of the as-read slab, captured BEFORE the tool
# exists. The $(...) form evaluates once, at parse time, and stores a number.
# Plain "equal" style would re-evaluate bound() on every use -- and after
# create_atoms that bounding box includes the tool and the chip, so the tool
# position printed during the run would follow the debris instead of the tool.
variable ztop   equal $(bound(all,zmax))
variable ztop   equal 121.43934524308008349
variable xright equal $(bound(all,xmax))
variable xright equal 462.98730781779374865
variable ymid   equal $(0.5*(bound(all,ymin)+bound(all,ymax)))
variable ymid   equal 77.999786853268915365

# --- interactions ------------------------------------------------------------
# Declared before the tool is built: delete_atoms overlap needs a pair style in
# order to build the neighbour list it searches.
if "${arm} == paper" then   "pair_style hybrid adp lj/cut 7.5"   "pair_coeff * * adp ${potential} Cu Ta Cu Ta NULL" elif "${arm} == deck"   "pair_style hybrid eam/alloy lj/cut 7.5"   "pair_coeff * * eam/alloy ${potential} Cu Ta Cu Ta NULL" else   "print 'ERROR: arm must be deck or paper, got ${arm}'"   "quit 1"
pair_style hybrid adp lj/cut 7.5
pair_coeff * * adp ${potential} Cu Ta Cu Ta NULL
pair_coeff * * adp /Users/hust-hwashin621m/Downloads/research_new_material/CuTa-Oscillatory-Nanoscratching-MD/potentials/CuTa_LJ15_2014.adp.txt Cu Ta Cu Ta NULL

pair_coeff 1 5 lj/cut ${eps_CuC} ${sig_CuC} ${rc_CuC}
pair_coeff 1 5 lj/cut 0.05477 ${sig_CuC} ${rc_CuC}
pair_coeff 1 5 lj/cut 0.05477 2.168 ${rc_CuC}
pair_coeff 1 5 lj/cut 0.05477 2.168 5.4
pair_coeff 3 5 lj/cut ${eps_CuC} ${sig_CuC} ${rc_CuC}
pair_coeff 3 5 lj/cut 0.05477 ${sig_CuC} ${rc_CuC}
pair_coeff 3 5 lj/cut 0.05477 2.168 ${rc_CuC}
pair_coeff 3 5 lj/cut 0.05477 2.168 5.4
pair_coeff 2 5 lj/cut ${eps_TaC} ${sig_TaC} ${rc_TaC}
pair_coeff 2 5 lj/cut 0.13 ${sig_TaC} ${rc_TaC}
pair_coeff 2 5 lj/cut 0.13 2.86575 ${rc_TaC}
pair_coeff 2 5 lj/cut 0.13 2.86575 7.164
pair_coeff 4 5 lj/cut ${eps_TaC} ${sig_TaC} ${rc_TaC}
pair_coeff 4 5 lj/cut 0.13 ${sig_TaC} ${rc_TaC}
pair_coeff 4 5 lj/cut 0.13 2.86575 ${rc_TaC}
pair_coeff 4 5 lj/cut 0.13 2.86575 7.164
# The tool is rigid, so its internal cohesion never enters the dynamics.
pair_coeff 5 5 none

neighbor 2 bin
neigh_modify every 1 delay 0 check yes
timestep ${dt_ps}
timestep 0.001

# Run-out room on the +x side and above the surface. create_atoms only fills
# the part of a region that lies inside the box, so without this the tool
# sphere is sliced off at the old x face and silently created with 0 atoms.
# The clearance is set by the tool, not by the scratch length: the tool starts
# at xright + gap + R and reaches to xright + gap + 2R, then travels the other
# way. Tying this to ${length} would break every short case.
variable x_headroom equal $(v_gap+2.0*v_radius+10.0)
variable x_headroom equal 80
variable z_headroom equal $(2.0*v_radius-v_depth+20.0)
variable z_headroom equal 70
change_box all x delta 0 ${x_headroom} z delta 0 ${z_headroom} units box
change_box all x delta 0 80 z delta 0 ${z_headroom} units box
change_box all x delta 0 80 z delta 0 70 units box
