fix sink_left   g_th_left   temp/rescale 10 ${temp_K} ${temp_K} 0.1 1.0
fix sink_left   g_th_left   temp/rescale 10 300.0 ${temp_K} 0.1 1.0
fix sink_left   g_th_left   temp/rescale 10 300.0 300.0 0.1 1.0

# DECK-FIX 2. The deck drives the tool with "velocity set" plus "setforce 0",
# which leaves the trajectory to be inferred from the integrator. fix move
# prescribes it exactly, so tool position is known analytically at every step
# and the contact criterion is not contaminated by integration drift.
# setforce still supplies the reaction force as f_tool_react[1..3] in
# eV/Angstrom, which is the only source analysis/ accepts for the loads.
fix tool_react tool setforce 0.0 0.0 0.0
fix tool_motion tool move linear -${vs} 0.0 0.0 units box
fix tool_motion tool move linear -0.3 0.0 0.0 units box

variable fx equal f_tool_react[1]
variable fy equal f_tool_react[2]
variable fz equal f_tool_react[3]
# "time" accumulates across runs, so the traverse has to be measured from the
# end of equilibration rather than from zero.
variable t_scratch_start equal $(v_eq_steps*v_dt_ps)
variable t_scratch_start equal 20
variable tool_x equal v_tool_x0-v_vs*(time-v_t_scratch_start)

compute pe_atom all pe/atom
compute stress_atom all stress/atom NULL
compute cna all cna/atom 3.5

# DECK-FIX 3. The deck samples forces every 200 steps and dumps every 500.
# The protocol requires >= 100 force samples per oscillation cycle in the
# oscillatory arm; the baseline is sampled at the same rate so the two are
# directly comparable rather than differently smoothed.
thermo 50
thermo_style custom step time temp c_t_work pe ke etotal press v_tool_x v_fx v_fy v_fz
WARNING: New thermo_style command, previous thermo_modify settings will be lost (src/output.cpp:912)
thermo_modify flush yes

# 34 MB per frame at 287k atoms. At dump_every 1000 a full 13 nm cut is ~430
# frames, i.e. ~15 GB per case, so the launcher sets this per campaign rather
# than the template fixing it.
dump traj all custom ${dump_every} ${run_dir}/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump traj all custom 1000 ${run_dir}/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump traj all custom 1000 /Volumes/CuTaData/CuTa-results/runs/scratch_base_R01/trajectories/scratch.*.dump   id type x y z vx vy vz c_pe_atom c_cna   c_stress_atom[1] c_stress_atom[2] c_stress_atom[3]   c_stress_atom[4] c_stress_atom[5] c_stress_atom[6]
dump_modify traj sort id

# DECK-FIX 4. Length is taken from the variable rather than a hard-coded step
# count, so a speed sweep traverses the same distance instead of the same time.
# The tool starts one gap clear of the side face, so the gap has to be added:
# ${length} is the cut length, not the total traverse. The deck's 450000 steps
# is 13.5 nm of traverse against a 0.5 nm gap, i.e. 13.0 nm of cutting, which
# is what the paper reports.
variable scratch_steps equal round((v_length+v_gap)/(v_vs*v_dt_ps))
print "scratch: cut ${length} A + gap ${gap} A at ${vs} A/ps = ${scratch_steps} steps"
scratch: cut 276.0 A + gap 10.0 A at 0.3 A/ps = 953333 steps

# Two-file cycling restart. A full cut is of order a day of wall time on this
# machine; without this any interruption costs the whole run. Cycling bounds the
# cost at two files rather than one per checkpoint.
restart 25000 ${run_dir}/metadata/restart.a ${run_dir}/metadata/restart.b
restart 25000 /Volumes/CuTaData/CuTa-results/runs/scratch_base_R01/metadata/restart.a ${run_dir}/metadata/restart.b
restart 25000 /Volumes/CuTaData/CuTa-results/runs/scratch_base_R01/metadata/restart.a /Volumes/CuTaData/CuTa-results/runs/scratch_base_R01/metadata/restart.b

run ${scratch_steps}
run 953333
