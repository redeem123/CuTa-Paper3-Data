# --- relaxation --------------------------------------------------------------
# preequilibrated=1 says ${structure} already carries an equilibrated thermal
# state. in.relax_assembled_structure.lmp ends with 20000 steps of NVT and
# write_data writes a Velocities section, so that state is already on disk;
# rebuilding it here costs 20 ps of wall time per case to reproduce a file the
# campaign wrote once. Ten cases share two structures, so it was paid five times
# over per replica.
#
# minimize goes with it, not as an optimisation but of necessity: LAMMPS zeroes
# velocities during minimisation, so minimising would discard the very state
# being reused. What the relax stage cannot cover is the tool's LJ field, the
# vacuum added by change_box and the re-zoning into fixed/heatsink, so a short
# settle still runs -- eq_steps_pre, not eq_steps.
variable preequilibrated index 0
variable eq_steps_pre    index 4000

# loop geom is required: delete_atoms uses "compress no" to keep atom IDs stable
# for the STZ and displacement analysis, leaving gaps that "loop all" rejects.
if "${preequilibrated} == 0" then   "min_style cg"   "minimize 1e-4 1e-6 20000 200000"   "velocity newtonian create ${temp_K} ${seed} loop geom"   "velocity heatsink create ${temp_K} ${seed} loop geom"

velocity fixed set 0.0 0.0 0.0

compute t_work newtonian temp

fix hold_fixed fixed setforce 0.0 0.0 0.0
fix eq_thermo newtonian nvt temp ${temp_K} ${temp_K} 0.1
fix eq_thermo newtonian nvt temp 300.0 ${temp_K} 0.1
fix eq_thermo newtonian nvt temp 300.0 300.0 0.1
fix eq_sink heatsink nvt temp ${temp_K} ${temp_K} 0.1
fix eq_sink heatsink nvt temp 300.0 ${temp_K} 0.1
fix eq_sink heatsink nvt temp 300.0 300.0 0.1

thermo 200
thermo_style custom step time temp c_t_work pe ke etotal press
thermo_modify flush yes

# A structure handed over with preequilibrated 1 but no Velocities section reads
# back at 0 K and would be scratched cold -- nothing downstream flags that until
# the forces come out wrong. The run 0 is what makes c_t_work current: an
# equal-style variable reading a compute that no thermo line has requested this
# timestep aborts with "Compute used in variable between runs is not current",
# so the guard sits below thermo_style, not above it. Flattened into one boolean
# per the convention above: a nested if inside an if argument does not survive
# LAMMPS quote parsing.
run 0 post no
